# Force LF line endings for Linux container files regardless of host OS.
* text=auto eol=lf

# Explicit overrides for files that MUST be LF (sha256sum -c, shell, Docker).
*.sh         text eol=lf
*.bash       text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.conf       text eol=lf
*.control    text eol=lf
*.patch      text eol=lf
SHA256SUMS   text eol=lf

# Binary files (none expected, but be explicit if any appear).
*.deb   binary
*.tar   binary
*.tgz   binary
*.gz    binary
*.zst   binary
*.png   binary
*.jpg   binary
*.ico   binary
